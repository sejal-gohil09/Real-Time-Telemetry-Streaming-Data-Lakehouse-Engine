# Environment Variables
# Copy this file to .env and fill in your values
#
# The app works WITHOUT any .env file — it falls back to bundled local data
# computed in the browser. To connect a real PostgreSQL database, see
# database/init.sql for the setup script and fill in the values below.

# Supabase (optional — enables live database mode)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
